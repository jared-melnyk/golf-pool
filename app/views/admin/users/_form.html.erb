<% password_required = local_assigns.fetch(:password_required) %>
<% submit_label = local_assigns.fetch(:submit_label) %>
<% form_url = local_assigns.fetch(:form_url) %>
<% form_method = local_assigns.fetch(:form_method) %>

<%= form_with model: @user, url: form_url, method: form_method, local: true, class: "space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <ul class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg list-disc list-inside">
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
    <p class="text-xs text-gray-500 mt-1">Used to sign in. Stored lowercase.</p>
  </div>

  <div>
    <%= f.label :ghin_handicap_index, "GHIN handicap index", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :ghin_handicap_index, step: 0.1, class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500", placeholder: "e.g. 12.4" %>
    <p class="text-xs text-gray-500 mt-1">Optional. Range −54 to 54.</p>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password, required: password_required, class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
    <% unless password_required %>
      <p class="text-xs text-gray-500 mt-1">Leave blank to keep the current password.</p>
    <% end %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password_confirmation, required: password_required, class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
  </div>

  <div class="flex flex-wrap gap-3 items-center">
    <%= f.submit submit_label, class: "bg-emerald-600 text-white px-4 py-2 rounded hover:bg-emerald-700 font-medium" %>
    <%= link_to "Cancel", admin_users_path, class: "text-sm text-gray-600 hover:text-gray-900 underline" %>
  </div>
<% end %>
