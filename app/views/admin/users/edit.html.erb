<div class="max-w-lg mx-auto border border-gray-200 rounded-lg p-6 bg-white shadow-sm">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">Edit user</h1>
  <p class="text-sm text-gray-600 mb-6"><%= @user.name %> · <%= @user.email %></p>

  <%= render "form",
        form_url: admin_user_path(@user),
        form_method: :patch,
        password_required: false,
        submit_label: "Save changes" %>
</div>
