<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Set up <%= @game.name %></h1>
    <p class="text-sm text-gray-600 mt-1">Step <%= setup_step_number(@step) %> of 3 · <%= @step.titleize %></p>
  </div>

  <% if flash[:alert].present? %>
    <p class="p-3 bg-red-50 border border-red-200 text-red-800 rounded"><%= flash[:alert] %></p>
  <% end %>

  <% if @step == "course" %>
    <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm"
             data-controller="course-search"
             data-course-search-search-url-value="<%= search_courses_game_setup_path(@game) %>"
             data-course-search-select-url-value="<%= select_course_game_setup_path(@game) %>">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Course & tee</h2>

      <%= form_with url: game_setup_path(@game), method: :patch, local: true, id: "course_save_form", class: "space-y-4" do %>
        <%= hidden_field_tag :step, "course" %>

        <div>
          <%= label_tag "round[played_on]", "Date played", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= date_field_tag "round[played_on]", @round_played_on,
                required: true,
                class: "rounded border border-gray-300 px-3 py-2" %>
          <p class="text-xs text-gray-500 mt-1">When is this round?</p>
        </div>

        <div class="relative">
          <%= label_tag :course_search_query, "Course or club name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= text_field_tag :course_search_query, @search_query,
                id: "course_search_query",
                autocomplete: "off",
                role: "combobox",
                "aria-expanded": "false",
                "aria-controls": "course_search_results",
                "aria-autocomplete": "list",
                placeholder: "Search courses…",
                class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500",
                data: {
                  course_search_target: "input",
                  action: "input->course-search#onInput focus->course-search#onFocus"
                } %>

          <div data-course-search-target="dropdown"
               class="hidden absolute z-20 mt-1 w-full rounded-md border border-gray-200 bg-white shadow-lg max-h-64 overflow-y-auto">
            <ul id="course_search_results"
                data-course-search-target="results"
                role="listbox"
                class="py-1 divide-y divide-gray-100"></ul>
          </div>
          <p class="text-xs text-gray-500 mt-1">Type at least 2 characters to search.</p>
        </div>

        <div data-course-search-target="selection" class="space-y-4 border-t border-gray-100 pt-4">
          <%= render "game_setups/course_selection",
                selected_course: @selected_course,
                tee_options: @tee_options,
                selected_tee_selector: @selected_tee_selector,
                error_message: @course_selection_error %>
        </div>

        <%= submit_tag "Save & continue", class: "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
      <% end %>
    </section>
  <% elsif @step == "format" %>
    <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Game format</h2>
      <% if @game.round.present? %>
        <p class="text-sm text-gray-600 mb-4">
          <%= @game.round.played_on.strftime("%b %-d, %Y") %> · <%= @game.round.club_name %> · <%= @game.round.course_name %>
        </p>
      <% end %>
      <%= form_with url: game_setup_path(@game), method: :patch, local: true, class: "space-y-4" do %>
        <%= hidden_field_tag :step, "format" %>
        <% Game::GAME_TYPES.each do |type| %>
          <label class="flex items-center gap-2">
            <%= radio_button_tag "game[game_type]", type, @game.game_type == type, required: true %>
            <%= type.gsub("_", " ").titleize %>
          </label>
        <% end %>
        <%= submit_tag "Save & continue", class: "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
      <% end %>
    </section>
  <% else %>
    <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm space-y-4">
      <h2 class="text-lg font-semibold text-gray-900">Invite players</h2>
      <p class="text-sm text-gray-600">Share this link so others can join the game.</p>
      <%= render "games/invite_players", game: @game %>
      <p class="flex flex-wrap gap-3 items-center">
        <%= link_to "Set up teams →", edit_teams_game_path(@game), class: "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
        <%= link_to "View scorecard", game_path(@game), class: "text-sm text-emerald-700 hover:underline" %>
      </p>
    </section>
  <% end %>

  <nav class="flex flex-wrap gap-4 text-sm">
    <% previous = setup_previous_step(@game, @step) %>
    <% if previous %>
      <%= link_to "← #{previous[:label]}", previous[:path], class: "text-emerald-700 hover:text-emerald-800 underline" %>
    <% end %>
    <%= link_to "← Back to games", games_path, class: "text-emerald-700 hover:text-emerald-800 underline" %>
  </nav>
</div>
