<%# locals: gtp, hole_number, gross_score, event, game, can_edit %>
<% if can_edit %>
  <%= form_with url: game_hole_score_path(game, gtp),
        method: :patch,
        class: "inline-flex items-center gap-2",
        data: {
          controller: "score-entry",
          score_entry_last_value_value: gross_score.to_s,
          turbo: true
        } do %>
    <%= hidden_field_tag :hole_number, hole_number %>
    <button type="button"
            class="inline-flex items-center justify-center w-11 h-11 rounded-lg border border-gray-300 bg-white text-xl font-semibold text-gray-800 active:bg-gray-100"
            data-action="score-entry#decrement"
            aria-label="Decrease score">−</button>
    <%= number_field_tag :gross_score,
          gross_score,
          min: 1, max: 15, inputmode: "numeric",
          id: dom_id(gtp, "mobile_gross_hole_#{hole_number}"),
          class: "w-14 h-11 rounded-lg border border-gray-300 px-1 text-center text-lg tabular-nums font-semibold focus:ring-2 focus:ring-emerald-500",
          data: {
            score_entry_target: "input",
            action: "change->score-entry#saveIfDirty blur->score-entry#saveIfDirty"
          } %>
    <button type="button"
            class="inline-flex items-center justify-center w-11 h-11 rounded-lg border border-gray-300 bg-white text-xl font-semibold text-gray-800 active:bg-gray-100"
            data-action="score-entry#increment"
            aria-label="Increase score">+</button>
  <% end %>
<% else %>
  <span class="inline-flex items-center justify-center w-14 h-11 text-lg tabular-nums font-semibold text-gray-700"><%= gross_score || "—" %></span>
<% end %>
