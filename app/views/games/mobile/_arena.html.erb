<%# locals: scorecard, game, event %>
<% default_hole = 1 %>
<% round = game.round %>
<% can_lock = game.member?(current_user) && (game.active? || game.completed?) %>

<div id="<%= dom_id(game, :mobile_arena) %>"
     class="space-y-3"
     data-controller="hole-stepper"
     data-hole-stepper-hole-value="<%= default_hole %>"
     data-hole-stepper-storage-key-value="game-<%= game.token %>-hole"
     data-hole-stepper-pars-value="<%= round.hole_pars.to_json %>"
     data-hole-stepper-stroke-indexes-value="<%= round.hole_handicaps.to_json %>">

  <%= render "games/mobile/standings", game: game, scorecard: scorecard unless game.field_scope? %>

  <% if game.field_scope? %>
    <% focus = scorecard_focus_team(scorecard, game) %>
    <% if focus && focus[:live_label].present? %>
      <div class="border border-emerald-200 rounded-xl bg-emerald-50 shadow-sm p-3 mb-3">
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide"><%= focus[:name] %></p>
        <p class="text-lg font-semibold text-emerald-900 tabular-nums"><%= focus[:live_label] %></p>
      </div>
    <% end %>
  <% end %>

  <div class="border border-gray-200 rounded-xl bg-white shadow-sm p-3">
    <div class="flex items-center justify-between gap-2 mb-3">
      <button type="button"
              class="inline-flex items-center justify-center min-w-[2.75rem] h-11 px-3 rounded-lg border border-gray-300 text-gray-800 text-sm font-medium active:bg-gray-50"
              data-action="hole-stepper#previous"
              aria-label="Previous hole">Back</button>
      <div class="text-center min-w-0">
        <p class="text-base font-semibold text-gray-900" data-hole-stepper-target="label">Hole <%= default_hole %></p>
        <p class="text-xs text-gray-500">
          <span data-hole-stepper-target="par">Par <%= round.hole_pars[default_hole - 1] %></span>
          ·
          <span data-hole-stepper-target="si">SI <%= round.hole_handicaps[default_hole - 1] %></span>
        </p>
      </div>
      <button type="button"
              class="inline-flex items-center justify-center min-w-[2.75rem] h-11 px-3 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 active:bg-emerald-700"
              data-action="hole-stepper#next"
              data-hole-stepper-target="nextButton"
              aria-label="Next hole">Next</button>
      <% if can_lock && game.active? %>
        <%# Wrapper owns visibility — do not combine Tailwind `hidden` + `inline` on the form (display clash). %>
        <div class="hidden" data-hole-stepper-target="lockControl">
          <%= button_to "Lock scorecard", complete_game_path(game), method: :patch,
                form: { data: { turbo_confirm: "Lock the scorecard for everyone?" } },
                class: "inline-flex items-center justify-center h-11 px-3 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700" %>
        </div>
      <% elsif can_lock && game.completed? %>
        <div class="hidden" data-hole-stepper-target="reopenControl">
          <%= button_to "Reopen scorecard", reopen_game_path(game), method: :patch,
                form: { data: { turbo_confirm: "Reopen the scorecard for editing?" } },
                class: "inline-flex items-center justify-center h-11 px-3 rounded-lg border border-gray-300 text-gray-800 text-sm font-medium hover:bg-gray-50" %>
        </div>
      <% end %>
    </div>

    <% (1..18).each do |h| %>
      <div data-hole-stepper-target="panel" data-hole="<%= h %>" class="<%= h == default_hole ? "" : "hidden" %>">
        <% if game.vegas? %>
          <%= render "games/mobile/vegas_hole",
                game: game, event: event, scorecard: scorecard, hole_number: h %>
        <% else %>
          <% scorecard[:teams].each_with_index do |team, idx| %>
            <% game_team = game.game_teams.detect { |gt| gt.id == team[:id] } %>
            <section class="<%= idx.positive? ? "mt-4 pt-4 border-t border-gray-200" : "" %>">
              <% if scorecard[:teams].size > 1 %>
                <h3 class="text-sm font-semibold text-gray-900 mb-2"><%= team[:name] %></h3>
              <% end %>
              <%= render "games/mobile/team_hole",
                    game: game,
                    event: event,
                    scorecard: scorecard,
                    team: team,
                    game_team: game_team,
                    hole_number: h %>
            </section>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <p class="text-xs text-center text-gray-500">
    Full scorecard tables are available on larger screens.
  </p>
</div>
