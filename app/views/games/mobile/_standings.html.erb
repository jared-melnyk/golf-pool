<%# locals: game, scorecard %>
<div id="<%= dom_id(game, :mobile_standings) %>" class="border border-gray-200 rounded-xl bg-white shadow-sm p-3 mb-3">
  <% if game.vegas? %>
    <p class="text-base font-semibold text-emerald-800"><%= scorecard[:wash][:label] %></p>
    <p class="text-xs text-gray-500 mt-0.5">Wash · this match</p>
  <% elsif game.forty_score? %>
    <% show_scaled = forty_score_shows_scaled?(scorecard) %>
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Leaderboard</p>
    <% if show_scaled %>
      <p class="text-xs text-gray-500 mb-2">Scaled adjusts threesomes (30 picks) to compare with foursomes.</p>
    <% end %>
    <ul class="space-y-2">
      <% scorecard[:leaderboard].each do |row| %>
        <li class="flex items-baseline justify-between gap-3 text-sm">
          <span class="font-medium text-gray-900">
            <span class="text-gray-500 tabular-nums mr-1"><%= row[:competition_vs_par] ? scorecard_display_rank(row[:rank], scorecard[:leaderboard]) : "—" %></span>
            <%= row[:team_name] %>
          </span>
          <span class="text-gray-700 tabular-nums text-right">
            <% if row[:actual_vs_par].nil? %>
              —
            <% elsif show_scaled %>
              <span class="font-semibold text-emerald-800">Scaled <%= "%+d" % row[:competition_vs_par] %></span>
              <span class="text-gray-400 text-xs block">Net vs par <%= "%+d" % row[:actual_vs_par] %></span>
            <% else %>
              <span class="font-semibold text-emerald-800">Net vs par <%= "%+d" % row[:actual_vs_par] %></span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Leaderboard</p>
    <% if scorecard[:leaderboard].none? { |row| row[:live_vs_par] } %>
      <p class="text-sm text-gray-500">No scores yet.</p>
    <% else %>
      <ul class="space-y-1.5">
        <% scorecard[:leaderboard].each do |row| %>
          <li class="flex items-baseline justify-between gap-3 text-sm">
            <span class="font-medium text-gray-900">
              <span class="text-gray-500 tabular-nums mr-1"><%= row[:live_vs_par] ? scorecard_display_rank(row[:rank], scorecard[:leaderboard]) : "—" %></span>
              <%= row[:team_name] %>
            </span>
            <span class="tabular-nums text-gray-700"><%= row[:live_label] || "—" %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
