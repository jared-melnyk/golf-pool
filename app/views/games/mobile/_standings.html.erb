<%# locals: game, scorecard %>
<div id="<%= dom_id(game, :mobile_standings) %>" class="border border-gray-200 rounded-xl bg-white shadow-sm p-3 mb-3">
  <% if game.vegas? %>
    <p class="text-base font-semibold text-emerald-800"><%= scorecard[:wash][:label] %></p>
    <p class="text-xs text-gray-500 mt-0.5">Wash · this match</p>
  <% elsif game.forty_score? %>
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Leaderboard</p>
    <ul class="space-y-2">
      <% scorecard[:leaderboard].each do |row| %>
        <li class="flex items-baseline justify-between gap-3 text-sm">
          <span class="font-medium text-gray-900">
            <span class="text-gray-500 tabular-nums mr-1"><%= row[:competition_vs_par] ? scorecard_display_rank(row[:rank], scorecard[:leaderboard]) : "—" %></span>
            <%= row[:team_name] %>
          </span>
          <span class="text-gray-700 tabular-nums text-right">
            <% if row[:competition_vs_par] %>
              Comp <%= "%+d" % row[:competition_vs_par] %>
              <span class="text-gray-400 text-xs block">Act <%= "%+d" % row[:actual_vs_par] %></span>
            <% else %>
              —
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Leaderboard</p>
    <ul class="space-y-1.5">
      <% scorecard[:leaderboard].each do |row| %>
        <li class="flex items-baseline justify-between gap-3 text-sm">
          <span class="font-medium text-gray-900">
            <span class="text-gray-500 tabular-nums mr-1"><%= row[:total_net_strokes] ? scorecard_display_rank(row[:rank], scorecard[:leaderboard]) : "—" %></span>
            <%= row[:team_name] %>
          </span>
          <span class="tabular-nums text-gray-700"><%= row[:total_net_strokes] || "—" %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
