<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @game.name %></h1>
    <% if @game.round.present? && @game.game_type.present? %>
      <p class="text-sm text-gray-500 mt-1">
        <%= game_type_label(@game.game_type) %>
        ·
        <% if @game.event.present? %>
          <%= link_to @game.round.name, event_path(@game.event), class: "text-emerald-700 hover:underline" %>
        <% else %>
          <%= @game.round.name %>
        <% end %>
        · <%= @game.round.course_name %> · <%= @game.round.played_on.strftime("%b %-d, %Y") %>
      </p>
    <% elsif @game.draft? %>
      <p class="text-sm text-gray-600 mt-1">Setup in progress.</p>
    <% end %>

    <% if @game.can_manage?(current_user) %>
      <div class="mt-4 flex flex-wrap gap-3 items-center">
        <%= render "games/invite_players", game: @game %>
        <% if @game.draft? %>
          <%= link_to "Continue setup →", game_setup_path(@game),
                class: "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
        <% else %>
          <%= link_to "Edit teams", edit_teams_game_path(@game),
                class: "rounded px-4 py-2 text-sm font-medium border border-gray-300 text-gray-800 hover:bg-gray-50" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @scorecard.blank? %>
    <% if @game.member?(current_user) && !@game.can_manage?(current_user) %>
      <div class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm">
        <p class="text-gray-600">Waiting for teams to be assigned.</p>
      </div>
    <% end %>
  <% elsif @scorecard[:teams].empty? %>
    <div class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm">
      <p class="text-gray-600">No teams set up yet.</p>
      <% if @game.can_manage?(current_user) %>
        <%= link_to "Set up teams →", edit_teams_game_path(@game), class: "mt-2 inline-block text-emerald-700 hover:underline text-sm" %>
      <% end %>
    </div>
  <% else %>
    <div id="scorecard_flash"></div>

    <%= render "games/format_rules", game: @game %>

    <div class="md:hidden">
      <%= render "games/mobile/arena", scorecard: @scorecard, game: @game, event: @event %>
    </div>

    <div class="hidden md:block space-y-4">
      <% if @game.forty_score? %>
        <%= render "scorecard_forty_score", scorecard: @scorecard, game: @game, event: @event %>
      <% elsif @game.cha_cha_cha? %>
        <%= render "scorecard_cha_cha_cha", scorecard: @scorecard, game: @game, event: @event %>
      <% elsif @game.vegas? %>
        <%= render "scorecard_vegas", scorecard: @scorecard, game: @game, event: @event %>
      <% else %>
        <%= render "scorecard", scorecard: @scorecard, game: @game, event: @event %>
      <% end %>
    </div>

    <% if @game.can_manage?(current_user) && (@game.active? || @game.completed?) %>
      <%= render "games/scorecard_lock", game: @game %>
    <% end %>
  <% end %>

  <% if @event.present? %>
    <%= link_to "← Back to event", event_path(@event), class: "text-sm text-emerald-700 hover:text-emerald-800 underline" %>
  <% else %>
    <%= link_to "← Back to games", games_path, class: "text-sm text-emerald-700 hover:text-emerald-800 underline" %>
  <% end %>
</div>
