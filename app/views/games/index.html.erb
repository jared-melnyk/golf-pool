<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">On-Course games</h1>
    <p class="text-sm text-gray-600 mt-1">Your scorecards and casual rounds.</p>
  </div>

  <p class="flex flex-wrap gap-3">
    <%= link_to "New game", new_game_path, class: "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
    <%= link_to "Plan a trip", new_event_path, class: "rounded px-4 py-2 text-sm font-medium border border-gray-300 text-gray-800 hover:bg-gray-50" %>
  </p>

  <% if @games.any? %>
    <ul class="space-y-3">
      <% @games.each do |game| %>
        <li class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <%= link_to game.name, game_path(game), class: "text-lg font-semibold text-emerald-700 hover:underline" %>
              <% if game.event.present? %>
                <p class="text-sm text-gray-500 mt-1">Trip: <%= link_to game.event.name, event_path(game.event), class: "text-emerald-700 hover:underline" %></p>
              <% end %>
              <% if game.round.present? && game.game_type.present? %>
                <p class="text-sm text-gray-600 mt-1">
                  <%= game_type_label(game.game_type) %> · <%= game.round.course_name %> · <%= game.round.played_on.strftime("%b %-d, %Y") %>
                </p>
              <% end %>
            </div>
            <span class="text-xs font-medium px-2 py-1 rounded-full <%= game.completed? ? "bg-gray-100 text-gray-700" : game.draft? ? "bg-amber-50 text-amber-800" : "bg-emerald-50 text-emerald-800" %>">
              <%= game.status.titleize %>
            </span>
          </div>
          <% if game.draft? && game.can_manage?(current_user) %>
            <p class="mt-2">
              <%= link_to "Continue setup →", game_setup_path(game), class: "text-sm text-emerald-700 hover:underline" %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-600">No games yet. <%= link_to "Start a new game", new_game_path, class: "text-emerald-700 hover:underline" %>.</p>
  <% end %>
</div>
