<%# Locals: game (Game), button_class (optional String) %>
<% button_class = local_assigns.fetch(
     :button_class,
     "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700"
   ) %>
<p data-controller="clipboard" data-invite-url="<%= game_url(game) %>">
  <button type="button"
          data-action="click->clipboard#copy"
          class="<%= button_class %>">
    Invite players
  </button>
  <span data-clipboard-target="feedback" class="ml-2 text-sm text-gray-600 hidden">Link copied!</span>
</p>
