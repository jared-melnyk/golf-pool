<%# Renders the Vegas (2v2 wash) scorecard with inline score entry.
    Locals: scorecard (hash from VegasScorecard), game (Game), event (Event) %>

<% can_edit = scorecard_can_edit?(game, event) %>
<% teams = scorecard[:teams] %>
<% team_a = teams[0] %>
<% team_b = teams[1] %>
<% game_team_a = game.game_teams.detect { |gt| gt.id == team_a[:id] } %>
<% game_team_b = game.game_teams.detect { |gt| gt.id == team_b[:id] } %>

<p class="text-sm text-gray-600 mb-4">
  Combine each team’s two <strong>net scores</strong> into a two-digit number (lower tens, higher ones).
  Lower team number wins the hole. Net birdie or better flips the other team’s digits.
  Points accumulate on a wash basis.
</p>

<%= render "games/scorecard/vegas_wash_summary", game: game, scorecard: scorecard %>

<% [ [ team_a, game_team_a ], [ team_b, game_team_b ] ].each do |team, game_team| %>
  <% gtps_for_team = scorecard_gtps_for_team(game_team) %>
  <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm overflow-x-auto mb-4">
    <h2 class="text-base font-semibold text-gray-900 mb-1"><%= team[:name] %></h2>
    <p class="text-xs text-gray-500 mb-3">
      <%= team[:players].map { |p| "#{p[:name]} (CH #{p[:course_handicap]} · PH #{p[:playing_handicap]})" }.join(" · ") %>
    </p>

    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="text-xs font-medium text-gray-500 border-b border-gray-300 bg-gray-50">
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Hole</th>
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Par</th>
          <% team[:players].each_with_index do |player, idx| %>
            <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
            <th class="<%= edge %> py-2 px-2 text-center whitespace-nowrap border-r border-gray-200"><%= player[:name] %></th>
            <th class="py-2 px-2 text-center whitespace-nowrap text-gray-400 border-r border-gray-200">Net</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% (1..18).each do |h| %>
          <% par = game.round.hole_pars[h - 1] %>
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="py-1.5 px-2 text-center font-medium text-gray-700 tabular-nums border-r border-gray-200"><%= h %></td>
            <td class="py-1.5 px-2 text-center text-gray-500 tabular-nums border-r border-gray-200"><%= par %></td>
            <% team[:players].each_with_index do |player, idx| %>
              <% player_hole = player[:hole_scores].find { |s| s[:hole_number] == h } %>
              <% gtp = gtps_for_team[player[:name]] %>
              <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
              <td class="<%= edge %> py-1.5 px-2 text-center whitespace-nowrap border-r border-gray-200">
                <span class="inline-flex items-center justify-center gap-0.5">
                  <%= render "games/scorecard/gross_score_field",
                        gtp: gtp,
                        hole_number: h,
                        gross_score: player_hole[:gross_score],
                        event: event,
                        game: game,
                        can_edit: can_edit && gtp.present? %>
                  <%= render "games/scorecard/stroke_dots", strokes: player_hole[:strokes_received] %>
                </span>
              </td>
              <%= render "games/scorecard/net_cell",
                    gtp: gtp,
                    hole_number: h,
                    net_score: player_hole[:net_score] %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm overflow-x-auto mb-4">
  <h2 class="text-base font-semibold text-gray-900 mb-3">Match</h2>
  <table class="w-full text-sm border-collapse">
    <thead>
      <tr class="text-xs font-medium text-gray-500 border-b border-gray-300 bg-gray-50">
        <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Hole</th>
        <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Par</th>
        <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200"><%= team_a[:name] %> #</th>
        <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200"><%= team_b[:name] %> #</th>
        <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Points</th>
        <th class="py-2 px-2 text-center whitespace-nowrap font-semibold text-emerald-700 border-l-2 border-emerald-200">Wash</th>
      </tr>
    </thead>
    <tbody id="<%= dom_id(game, :vegas_holes) %>">
      <%= render "games/scorecard/vegas_hole_rows",
            game: game,
            scorecard: scorecard,
            team_a: team_a,
            team_b: team_b %>
    </tbody>
  </table>
</section>
