<%# Locals: scorecard (from FortyScoreScorecard), game, event %>

<section class="mb-6 border border-amber-200 rounded-lg p-4 bg-amber-50 text-sm text-amber-950">
  <p class="font-medium">40 Score</p>
  <p class="mt-1 text-amber-900/90">
  Your group selects counted net scores: <strong>40</strong> for a foursome, <strong>30</strong> for a threesome (0–4 picks per hole, any mix).
    <%= link_to "How it works →", "https://www.thefriedegg.com/articles/how-to-play-golf-game-40-score",
          class: "underline font-medium hover:text-amber-950", target: "_blank", rel: "noopener" %>
    Playing handicap uses <strong>100%</strong> of course handicap.
    The leaderboard ranks by <strong>net vs par</strong> on counted holes.
    If any group is a threesome, a <strong>scaled</strong> line also appears so 30-pick and 40-pick groups compare fairly.
  </p>
</section>

<% scorecard[:teams].each do |team| %>
  <% game_team = game.game_teams.detect { |gt| gt.id == team[:id] } %>
  <% gtps_for_team = scorecard_gtps_for_team(game_team) %>
  <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm overflow-x-auto mb-4">
    <div class="flex flex-wrap gap-3 items-baseline justify-between mb-3">
      <h2 class="text-base font-semibold text-gray-900"><%= team[:name] %></h2>
      <%= render "games/scorecard/forty_team_header",
            game_team: game_team,
            team_data: team,
            show_scaled: forty_score_shows_scaled?(scorecard) %>
    </div>

    <p class="text-xs text-gray-500 mb-3">
      <%= team[:players].map { |p| "#{p[:name]} (CH #{p[:course_handicap]} · PH #{p[:playing_handicap]})" }.join(" · ") %>
    </p>

    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="text-xs font-medium text-gray-500 border-b border-gray-300 bg-gray-50">
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Hole</th>
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Par</th>
          <% team[:players].each_with_index do |player, idx| %>
            <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
            <th class="<%= edge %> py-2 px-2 text-center whitespace-nowrap border-r border-gray-200"><%= player[:name] %></th>
            <th class="py-2 px-2 text-center whitespace-nowrap text-gray-400 border-r border-gray-200">Net</th>
            <th class="py-2 px-2 text-center whitespace-nowrap text-emerald-800 border-r border-gray-200">Count?</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% (1..18).each do |h| %>
          <% par = game.round.hole_pars[h - 1] %>
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="py-1.5 px-2 text-center font-medium text-gray-700 tabular-nums border-r border-gray-200"><%= h %></td>
            <td class="py-1.5 px-2 text-center text-gray-500 tabular-nums border-r border-gray-200"><%= par %></td>
            <% team[:players].each_with_index do |player, idx| %>
              <% player_hole = player[:hole_scores].find { |s| s[:hole_number] == h } %>
              <% gtp = gtps_for_team[player[:name]] %>
              <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
              <td class="<%= edge %> py-1.5 px-2 text-center whitespace-nowrap border-r border-gray-200">
                <span class="inline-flex items-center justify-center gap-0.5">
                  <%= render "games/scorecard/gross_score_field",
                        gtp: gtp,
                        hole_number: h,
                        gross_score: player_hole[:gross_score],
                        event: event,
                        game: game,
                        can_edit: scorecard_can_edit_gross?(game, gtp) %>
                <%= render "games/scorecard/stroke_dots", strokes: player_hole[:strokes_received] %>
                </span>
              </td>
              <%= render "games/scorecard/net_cell",
                    gtp: gtp,
                    hole_number: h,
                    net_score: player_hole[:net_score] %>
              <%= render "games/scorecard/forty_pick_cell",
                    gtp: gtp,
                    game_team: game_team,
                    hole_number: h,
                    player_hole: player_hole,
                    event: event,
                    game: game,
                    can_edit: scorecard_can_edit_forty_pick?(game, gtp) %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<%= render "games/scorecard/leaderboard_forty_score", game: game, scorecard: scorecard %>
