<%# Locals: scorecard (from FortyScoreScorecard), game, event %>
<% can_edit = !game.submitted &&
    (event.commissioner?(current_user) ||
     game.game_teams.joins(:game_team_players).where(game_team_players: { user_id: current_user.id }).exists?) %>

<% gtp_by_name = {} %>
<% scorecard[:teams].each do |t| %>
  <% t[:players].each do |p| %>
    <% gtp_by_name[p[:name]] ||= GameTeamPlayer
          .joins(:game_team, :user)
          .where(game_teams: { game_id: game.id })
          .where(users: { name: p[:name] }).first %>
  <% end %>
<% end %>

<section class="mb-6 border border-amber-200 rounded-lg p-4 bg-amber-50 text-sm text-amber-950">
  <p class="font-medium">40 Score</p>
  <p class="mt-1 text-amber-900/90">
    Your group selects exactly <strong>40 counted net scores</strong> across 18 holes (0–4 picks per hole, any mix).
    <%= link_to "How it works →", "https://www.thefriedegg.com/articles/how-to-play-golf-game-40-score",
          class: "underline font-medium hover:text-amber-950", target: "_blank", rel: "noopener" %>
    Playing handicap uses <strong>100%</strong> of course handicap. Leaderboard ranks groups by strokes under par on those 40 scores.
  </p>
</section>

<% scorecard[:teams].each do |team| %>
  <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm overflow-x-auto mb-4">
    <div class="flex flex-wrap gap-3 items-baseline justify-between mb-3">
      <h2 class="text-base font-semibold text-gray-900"><%= team[:name] %></h2>
      <p class="text-xs text-gray-600">
        <%= team[:selected_count] %> / 40 picks
        <% unless team[:net_under_par].nil? %>
          · <span class="font-semibold text-emerald-700">Vs par <%= "%+d" % team[:net_under_par] %></span>
          (<span title="Counted net strokes"><%= team[:total_selected_net] %></span> net /
          <%= team[:total_selected_par] %> par)
        <% end %>
      </p>
    </div>

    <p class="text-xs text-gray-500 mb-3">
      <%= team[:players].map { |p| "#{p[:name]} (CH #{p[:course_handicap]} · PH #{p[:playing_handicap]})" }.join(" · ") %>
    </p>

    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs font-medium text-gray-500 border-b border-gray-200">
          <th class="pb-2 pr-3">Hole</th>
          <th class="pb-2 pr-3">Par</th>
          <% team[:players].each do |player| %>
            <th class="pb-2 pr-3"><%= player[:name] %></th>
            <th class="pb-2 pr-3 text-gray-400">Net</th>
            <th class="pb-2 pr-3 text-emerald-800">Count?</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% (1..18).each do |h| %>
          <% par = game.round.hole_pars[h - 1] %>
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="py-1 pr-3 font-medium text-gray-700"><%= h %></td>
            <td class="py-1 pr-3 text-gray-500"><%= par %></td>
            <% team[:players].each do |player| %>
              <% player_hole = player[:hole_scores].find { |s| s[:hole_number] == h } %>
              <% gtp = gtp_by_name[player[:name]] %>
              <td class="py-1 pr-2">
                <% if can_edit && gtp %>
                  <%= form_with url: event_game_hole_score_path(event, game, gtp),
                        method: :patch, local: true, class: "inline" do %>
                    <%= hidden_field_tag :hole_number, h %>
                    <%= number_field_tag :gross_score,
                          player_hole[:gross_score],
                          min: 1, max: 15, size: 3,
                          class: "w-12 rounded border border-gray-300 px-1 py-0.5 text-center text-sm focus:ring-1 focus:ring-emerald-500",
                          onchange: "this.form.submit()" %>
                  <% end %>
                <% else %>
                  <span class="text-gray-700"><%= player_hole[:gross_score] || "—" %></span>
                <% end %>
                <% if player_hole[:strokes_received].to_i > 0 %>
                  <span class="text-xs text-emerald-600 ml-0.5 select-none" title="<%= player_hole[:strokes_received] %> stroke(s) received">·</span>
                <% end %>
              </td>
              <td class="py-1 pr-3 text-gray-500 text-xs"><%= player_hole[:net_score] || "—" %></td>
              <td class="py-1 pr-3">
                <% if can_edit && gtp %>
                  <%= form_with url: event_game_hole_score_path(event, game, gtp),
                        method: :patch, local: true, class: "inline-flex items-center gap-1" do %>
                    <%= hidden_field_tag :hole_number, h %>
                    <%= hidden_field_tag :forty_pick_only, "1" %>
                    <%= hidden_field_tag :included_in_forty_score, "0" %>
                    <%= check_box_tag :included_in_forty_score, "1", player_hole[:included_in_forty_score],
                          id: "fs_#{team[:id]}_#{gtp.id}_#{h}",
                          disabled: player_hole[:gross_score].blank?,
                          class: "rounded border-gray-400 text-emerald-600 focus:ring-emerald-500",
                          onchange: "this.form.submit()" %>
                  <% end %>
                <% else %>
                  <span><%= player_hole[:included_in_forty_score] ? "✓" : "—" %></span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm">
  <h2 class="text-base font-semibold text-gray-900 mb-3">Leaderboard (40 counted scores)</h2>
  <% complete = scorecard[:leaderboard].select { |row| row[:rank] } %>
  <% if complete.empty? %>
    <p class="text-sm text-gray-500">Every group needs 40 picks with gross scores before rankings appear.</p>
  <% end %>
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs font-medium text-gray-500 border-b border-gray-200">
        <th class="pb-2 pr-4">Pos</th>
        <th class="pb-2 pr-4">Team</th>
        <th class="pb-2 pr-4">Vs par</th>
        <th class="pb-2">Counted net</th>
      </tr>
    </thead>
    <tbody>
      <% scorecard[:leaderboard].each do |row| %>
        <tr class="border-b border-gray-100">
          <td class="py-1 pr-4 font-medium">
            <%= row[:rank] ? "T#{row[:rank]}" : "—" %>
          </td>
          <td class="py-1 pr-4"><%= row[:team_name] %></td>
          <td class="py-1 pr-4">
            <% if row[:net_under_par].nil? %>
              —
            <% else %>
              <%= "%+d" % row[:net_under_par] %>
            <% end %>
          </td>
          <td class="py-1"><%= row[:total_selected_net] || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
