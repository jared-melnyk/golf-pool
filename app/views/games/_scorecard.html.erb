<%# Renders the full Best Ball scorecard with inline score entry and leaderboard.
    Locals: scorecard (hash from BestBallScorecard), game (Game), event (Event) %>

<% can_edit = scorecard_can_edit?(game, event) %>

<% scorecard[:teams].each do |team| %>
  <% game_team = game.game_teams.detect { |gt| gt.id == team[:id] } %>
  <% gtps_for_team = scorecard_gtps_for_team(game_team) %>
  <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm overflow-x-auto mb-4">
    <h2 class="text-base font-semibold text-gray-900 mb-1"><%= team[:name] %></h2>
    <p class="text-xs text-gray-500 mb-3">
      <%= team[:players].map { |p| "#{p[:name]} (CH #{p[:course_handicap]} · PH #{p[:playing_handicap]})" }.join(" · ") %>
    </p>

    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs font-medium text-gray-500 border-b border-gray-200">
          <th class="pb-2 pr-3">Hole</th>
          <th class="pb-2 pr-3">Par</th>
          <% team[:players].each do |player| %>
            <th class="pb-2 pr-3"><%= player[:name] %></th>
            <th class="pb-2 pr-3 text-gray-400">Net</th>
          <% end %>
          <th class="pb-2 font-semibold text-emerald-700">Best Ball</th>
        </tr>
      </thead>
      <tbody>
        <% (1..18).each do |h| %>
          <% par = game.round.hole_pars[h - 1] %>
          <% team_hole = team[:hole_scores].find { |s| s[:hole_number] == h } %>
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="py-1 pr-3 font-medium text-gray-700"><%= h %></td>
            <td class="py-1 pr-3 text-gray-500"><%= par %></td>
            <% team[:players].each do |player| %>
              <% player_hole = player[:hole_scores].find { |s| s[:hole_number] == h } %>
              <% gtp = gtps_for_team[player[:name]] %>
              <td class="py-1 pr-2">
                <%= render "games/scorecard/gross_score_field",
                      gtp: gtp,
                      hole_number: h,
                      gross_score: player_hole[:gross_score],
                      event: event,
                      game: game,
                      can_edit: can_edit && gtp.present? %>
                <% if player_hole[:strokes_received].to_i > 0 %>
                  <span class="text-xs text-emerald-600 ml-0.5 select-none" title="<%= player_hole[:strokes_received] %> stroke(s) received">·</span>
                <% end %>
              </td>
              <%= render "games/scorecard/net_cell",
                    gtp: gtp,
                    hole_number: h,
                    net_score: player_hole[:net_score] %>
            <% end %>
            <%= render "games/scorecard/best_ball_cell",
                  game_team: game_team,
                  hole_number: h,
                  best_ball_net: team_hole[:best_ball_net] %>
          </tr>
        <% end %>
        <tr class="border-t-2 border-gray-300 font-semibold">
          <td class="pt-2 pr-3 text-gray-900">Total</td>
          <td class="pt-2 pr-3 text-gray-500"><%= game.round.par_total %></td>
          <% team[:players].each do %>
            <td class="pt-2 pr-2"></td>
            <td class="pt-2 pr-3"></td>
          <% end %>
          <%= render "games/scorecard/team_total",
                game_team: game_team,
                total_net_strokes: team[:total_net_strokes] %>
        </tr>
      </tbody>
    </table>
  </section>
<% end %>

<%= render "games/scorecard/leaderboard_best_ball", game: game, scorecard: scorecard %>
