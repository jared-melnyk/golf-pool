<%# Renders the Cha-Cha-Cha (1-2-3) scorecard with inline score entry and leaderboard.
    Locals: scorecard (hash from ChaChaChaScorecard), game (Game), event (Event) %>

<% can_edit = scorecard_can_edit?(game, event) %>

<p class="text-sm text-gray-600 mb-4">
  Count the lowest <strong>1</strong>, then <strong>2</strong>, then <strong>3</strong> net scores per hole; the pattern repeats every three holes.
</p>

<% scorecard[:teams].each do |team| %>
  <% game_team = game.game_teams.detect { |gt| gt.id == team[:id] } %>
  <% gtps_for_team = scorecard_gtps_for_team(game_team) %>
  <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm overflow-x-auto mb-4">
    <h2 class="text-base font-semibold text-gray-900 mb-1"><%= team[:name] %></h2>
    <p class="text-xs text-gray-500 mb-3">
      <%= team[:players].map { |p| "#{p[:name]} (CH #{p[:course_handicap]} · PH #{p[:playing_handicap]})" }.join(" · ") %>
    </p>

    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="text-xs font-medium text-gray-500 border-b border-gray-300 bg-gray-50">
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Hole</th>
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200" title="Scores counting this hole">#</th>
          <th class="py-2 px-2 text-center whitespace-nowrap border-r border-gray-200">Par</th>
          <% team[:players].each_with_index do |player, idx| %>
            <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
            <th class="<%= edge %> py-2 px-2 text-center whitespace-nowrap border-r border-gray-200"><%= player[:name] %></th>
            <th class="py-2 px-2 text-center whitespace-nowrap text-gray-400 border-r border-gray-200">Net</th>
          <% end %>
          <th class="py-2 px-2 text-center whitespace-nowrap font-semibold text-emerald-700 border-l-2 border-emerald-200">Team Net</th>
        </tr>
      </thead>
      <tbody>
        <% (1..18).each do |h| %>
          <% par = game.round.hole_pars[h - 1] %>
          <% team_hole = team[:hole_scores].find { |s| s[:hole_number] == h } %>
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="py-1.5 px-2 text-center font-medium text-gray-700 tabular-nums border-r border-gray-200"><%= h %></td>
            <td class="py-1.5 px-2 text-center border-r border-gray-200">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-semibold" title="<%= team_hole[:scores_to_count] %> counting score<%= team_hole[:scores_to_count] == 1 ? "" : "s" %>">
                <%= team_hole[:scores_to_count] %>
              </span>
            </td>
            <td class="py-1.5 px-2 text-center text-gray-500 tabular-nums border-r border-gray-200"><%= par %></td>
            <% team[:players].each_with_index do |player, idx| %>
              <% player_hole = player[:hole_scores].find { |s| s[:hole_number] == h } %>
              <% gtp = gtps_for_team[player[:name]] %>
              <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
              <td class="<%= edge %> py-1.5 px-2 text-center whitespace-nowrap border-r border-gray-200">
                <span class="inline-flex items-center justify-center gap-0.5">
                  <%= render "games/scorecard/gross_score_field",
                        gtp: gtp,
                        hole_number: h,
                        gross_score: player_hole[:gross_score],
                        event: event,
                        game: game,
                        can_edit: can_edit && gtp.present? %>
                  <%= render "games/scorecard/stroke_dots", strokes: player_hole[:strokes_received] %>
                </span>
              </td>
              <%= render "games/scorecard/net_cell",
                    gtp: gtp,
                    hole_number: h,
                    net_score: player_hole[:net_score] %>
            <% end %>
            <%= render "games/scorecard/cha_cha_hole_cell",
                  game_team: game_team,
                  hole_number: h,
                  team_net_strokes: team_hole[:team_net_strokes] %>
          </tr>
        <% end %>
        <tr class="border-t-2 border-gray-300 font-semibold bg-gray-50">
          <td class="pt-2 pb-1 px-2 text-center text-gray-900 border-r border-gray-200">Total</td>
          <td class="pt-2 pb-1 px-2 border-r border-gray-200"></td>
          <td class="pt-2 pb-1 px-2 text-center text-gray-500 tabular-nums border-r border-gray-200"><%= game.round.par_total %></td>
          <% team[:players].each_with_index do |_player, idx| %>
            <% edge = idx.positive? ? "border-l-2 border-gray-300" : "" %>
            <td class="<%= edge %> pt-2 pb-1 px-2 border-r border-gray-200"></td>
            <td class="pt-2 pb-1 px-2 border-r border-gray-200"></td>
          <% end %>
          <%= render "games/scorecard/team_total",
                game_team: game_team,
                total_net_strokes: team[:total_net_strokes] %>
        </tr>
      </tbody>
    </table>
  </section>
<% end %>

<%= render "games/scorecard/leaderboard_cha_cha_cha", game: game, scorecard: scorecard %>
