<h1 class="text-2xl font-bold text-gray-900 mb-2"><%= @tournament.name %> — <%= @pool.name %></h1>
<p class="text-gray-600 mb-4">
  <%= @tournament.starts_at&.strftime("%B %d, %Y") %>
  <% if @tournament.completed? %>
    · <span class="font-medium text-emerald-700">Completed</span>
  <% elsif @tournament.started? %>
    · <span class="font-medium text-blue-700">In progress</span>
  <% else %>
    · <span class="font-medium text-gray-700">Not started</span>
  <% end %>
</p>

<%= link_to "Back to pool", @pool, class: "text-sm text-emerald-700 hover:text-emerald-800 underline mb-6 inline-block" %>

<% if @picks_by_user.blank? %>
  <p class="mb-4 text-sm text-blue-800 bg-blue-50 border border-blue-200 rounded px-3 py-2">
    No picks were submitted for this tournament in this pool, so there are no results to display.
  </p>
<% elsif @round_results.blank? && @tournament.started? %>
  <p class="mb-4 text-sm text-yellow-800 bg-yellow-50 border border-yellow-200 rounded px-3 py-2">
    Live scores are temporarily unavailable. Try refreshing in a moment.
  </p>
<% end %>

<% if @tournament.completed? && @tournament.no_cut_event? %>
  <p class="mb-4 text-sm text-indigo-800 bg-indigo-50 border border-indigo-200 rounded px-3 py-2">
    This event was treated as a no-cut tournament. Cut Made Bonus eligibility uses a synthetic cut line: top 45% of the field, plus ties.
    <% if @synthetic_cut_marginal_total_to_par.present? %>
      The worst (highest) score-to-par among players eligible for the Cut Made Bonus was <strong><%= format_total_to_par(@synthetic_cut_marginal_total_to_par) %></strong>.
    <% end %>
  </p>
<% end %>

<% rounds = (1..4).to_a %>

<div class="mt-4 space-y-6">
  <% @picks_by_user.each do |user, picks| %>
    <% pick = picks.first %>
    <%
      if @show_counted_dropped_badges
        golfer_totals = pick.golfers.map { |g| [ g.id, @scoring_display.ranking_total_for_counted_dropped(g) || 0.to_d ] }
        counted_golfer_ids = golfer_totals.sort_by { |(_, total)| -total }.first(3).map(&:first)
      else
        counted_golfer_ids = []
      end
      sorted_golfers = @scoring_display.sort_golfers_for_display(pick.golfers)
    %>
    <div class="border border-gray-200 rounded-lg bg-white shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900"><%= user.name %></h2>
      </div>
      <div class="p-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600">Golfer</th>
              <% rounds.each do |r| %>
                <% is_live = (@current_round == r) %>
                <th class="px-3 py-2 text-center text-xs font-semibold <%= is_live ? "text-blue-900" : "text-gray-600" %>">
                  R<%= r %><%= is_live ? " (Live)" : "" %>
                </th>
              <% end %>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600">Total</th>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600">
                Prize Money<% if @badges_projected %> <span class="font-normal text-gray-400">(projected)</span><% end %>
              </th>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600">Cut Made Bonus</th>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600">
                Total Earnings<% if @badges_projected %> <span class="font-normal text-gray-400">(projected)</span><% end %>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% sorted_golfers.each do |golfer| %>
              <% player_result = @round_results[golfer.external_id&.to_i] || {} %>
              <% rounds_hash = player_result[:rounds] || {} %>
              <% total_to_par = player_result[:total_to_par] %>
              <% prize = @golfer_prize_money[golfer.id] %>
              <% bonus_val = @golfer_bonus_display[golfer.id] %>
              <% total_earnings = @scoring_display.total_earnings_for(golfer) %>
              <% dropped = @show_counted_dropped_badges && counted_golfer_ids.exclude?(golfer.id) %>
              <tr>
                <td class="px-3 py-3 align-top">
                  <div class="flex flex-col gap-1">
                    <span class="font-medium text-gray-900"><%= golfer.name %></span>
                    <span class="text-xs text-gray-500">
                      <% odds = PoolTournamentOdds.find_by(pool_tournament: @pool_tournament, golfer: golfer)&.american_odds %>
                      <%= cut_made_bonus_label(odds, tournament: @tournament) %>
                    </span>
                    <% if @show_counted_dropped_badges && counted_golfer_ids.include?(golfer.id) %>
                      <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 w-fit">
                        Counted<%= " (projected)" if @badges_projected %>
                      </span>
                    <% elsif @show_counted_dropped_badges %>
                      <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 w-fit">
                        Dropped<%= " (projected)" if @badges_projected %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <% rounds.each do |r| %>
                  <% round_data = rounds_hash[r] %>
                  <% is_live = (@current_round == r) %>
                  <td class="px-3 py-3 text-center align-middle <%= is_live ? "bg-blue-50 text-blue-900 font-semibold" : "text-gray-700" %>">
                    <% if round_data %>
                      <%= round_data[:par_relative] %><% if round_data[:last_hole_completed].present? %><span class="text-gray-500 font-normal"> (<%= round_data[:last_hole_completed] == 18 ? "F" : round_data[:last_hole_completed] %>)</span><% end %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                <% end %>
                <td class="px-3 py-3 text-right align-middle whitespace-nowrap">
                  <span class="font-semibold text-gray-900"><%= format_total_to_par(total_to_par) %></span>
                  <% if player_result[:position].present? %>
                    <span class="ml-1 text-xs text-gray-500">(<%= player_result[:position] %>)</span>
                  <% end %>
                </td>
                <td class="px-3 py-3 text-right align-middle whitespace-nowrap <%= @badges_projected ? "text-gray-400" : "text-gray-700" %>">
                  <% if prize.nil? %>
                    —
                  <% else %>
                    $<%= number_with_delimiter(prize.to_i) %>
                  <% end %>
                </td>
                <td class="px-3 py-3 text-right align-middle whitespace-nowrap text-gray-700">
                  <% if bonus_val == :mc %>
                    MC
                  <% elsif bonus_val.is_a?(Numeric) && bonus_val.positive? %>
                    $<%= number_with_delimiter(bonus_val.to_i) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="px-3 py-3 text-right align-middle whitespace-nowrap font-medium <%= @badges_projected ? "text-gray-400" : "text-gray-700" %>">
                  <% if total_earnings.nil? %>
                    —
                  <% else %>
                    <% amt = "$#{number_with_delimiter(total_earnings.to_i)}" %>
                    <% if dropped %>
                      <span class="line-through text-gray-400 decoration-gray-400"><%= amt %></span>
                    <% else %>
                      <%= amt %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <%
              round_totals = rounds.map { |r| pick.golfers.sum { |g| ((@round_results[g.external_id&.to_i] || {})[:rounds] || {})[r]&.dig(:score_to_par).to_i } }
              total_to_par_sum = pick.golfers.sum { |g| ((@round_results[g.external_id&.to_i] || {})[:total_to_par].to_i) }
              prize_sum = if @show_counted_dropped_badges
                pick.golfers
                  .select { |g| counted_golfer_ids.include?(g.id) }
                  .sum { |g| @golfer_prize_money[g.id].to_d }
              else
                pick.golfers.sum { |g| @golfer_prize_money[g.id].to_d }
              end
              bonus_sum = pick.golfers.sum { |g| b = @golfer_bonus_display[g.id]; b.is_a?(Numeric) ? b.to_d : 0 }
              total_earnings_sum = if @show_counted_dropped_badges
                pick.golfers
                  .select { |g| counted_golfer_ids.include?(g.id) }
                  .sum { |g| @scoring_display.total_earnings_for(g).to_d }
              else
                0.to_d
              end
              any_round_data = round_totals.any?(&:nonzero?) || total_to_par_sum.nonzero?
              any_prize_sum = @tournament.completed? || (@badges_projected && prize_sum.positive?)
              any_total_earnings = (@tournament.completed? || @badges_projected) &&
                pick.golfers.any? { |g| !@scoring_display.total_earnings_for(g).nil? }
              format_score = ->(v) { v.zero? ? "E" : (v.positive? ? "+#{v}" : v.to_s) }
            %>
            <tr class="bg-gray-50 border-t-2 border-gray-200 font-semibold text-gray-900">
              <td class="px-3 py-3 align-top">Total</td>
              <% rounds.each_with_index do |r, i| %>
                <td class="px-3 py-3 text-center align-middle whitespace-nowrap">
                  <%= any_round_data ? format_score.call(round_totals[i]) : "—" %>
                </td>
              <% end %>
              <td class="px-3 py-3 text-right align-middle whitespace-nowrap">
                <%= any_round_data ? format_total_to_par(total_to_par_sum) : "—" %>
              </td>
              <td class="px-3 py-3 text-right align-middle whitespace-nowrap <%= @badges_projected ? "text-gray-400" : "" %>">
                <% if any_prize_sum %>
                  $<%= number_with_delimiter(prize_sum.to_i) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-3 py-3 text-right align-middle whitespace-nowrap">
                $<%= number_with_delimiter(bonus_sum.to_i) %>
              </td>
              <td class="px-3 py-3 text-right align-middle whitespace-nowrap <%= @badges_projected ? "text-gray-400" : "" %>">
                <%= any_total_earnings ? "$#{number_with_delimiter(total_earnings_sum.to_i)}" : "—" %>
              </td>
            </tr>
          </tbody>
        </table>
        <p class="text-xs text-gray-500 mt-2">
          <% if @badges_projected %>
            Grey amounts are projected from live position and last year's payout pattern (or a standard Tour table).
            Final prize money and Counted/Dropped are official after the tournament ends.
          <% elsif !@tournament.completed? %>
            Total earnings and Counted/Dropped are shown after final prize money is posted.
            Cut Made Bonus reflects make-cut status only while play is in progress.
          <% else %>
            Excluded golfers do not count toward the Total row.
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
</div>

