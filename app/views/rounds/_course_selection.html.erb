<%# Locals: selected_course, tee_options, selected_tee_selector, error_message (optional), default_round_name (optional) %>
<div class="space-y-4">
  <div>
    <%= label_tag "round[name]", "Round name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= text_field_tag "round[name]",
          local_assigns[:default_round_name],
          required: true,
          id: "round_name",
          class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
    <p class="mt-1 text-xs text-gray-500">Defaults from selected course; you can edit this.</p>
  </div>

  <%= render "shared/course_searches/selection",
        selected_course: selected_course,
        tee_options: tee_options,
        selected_tee_selector: selected_tee_selector,
        error_message: local_assigns[:error_message] %>
</div>
