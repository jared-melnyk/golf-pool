<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Create round</h1>
    <p class="text-sm text-gray-600 mt-1">
      Search for a course, select a tee, and snapshot 18-hole handicap fields for this event.
    </p>
  </div>

  <% if flash[:alert].present? || flash.now[:alert].present? %>
    <p class="p-3 bg-red-50 border border-red-200 text-red-800 rounded"><%= flash[:alert] || flash.now[:alert] %></p>
  <% end %>

  <section class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm"
           data-controller="course-search"
           data-course-search-search-url-value="<%= search_courses_event_rounds_path(@event) %>"
           data-course-search-select-url-value="<%= select_course_event_rounds_path(@event) %>">
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Course & tee</h2>

    <%= form_with model: @round, url: event_rounds_path(@event), method: :post, local: true, class: "space-y-4" do |f| %>
      <% if @round.errors.any? %>
        <ul class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg list-disc list-inside">
          <% @round.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>

      <div>
        <%= f.label :played_on, "Date played", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :played_on, required: true, class: "rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div class="relative">
        <%= label_tag :course_search_query, "Course or club name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag :course_search_query, @search_query,
              id: "course_search_query",
              autocomplete: "off",
              role: "combobox",
              "aria-expanded": "false",
              "aria-controls": "course_search_results",
              "aria-autocomplete": "list",
              placeholder: "Search courses…",
              class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500",
              data: {
                course_search_target: "input",
                action: "input->course-search#onInput focus->course-search#onFocus"
              } %>

        <div data-course-search-target="dropdown"
             class="hidden absolute z-20 mt-1 w-full rounded-md border border-gray-200 bg-white shadow-lg max-h-64 overflow-y-auto">
          <ul id="course_search_results"
              data-course-search-target="results"
              role="listbox"
              class="py-1 divide-y divide-gray-100"></ul>
        </div>
        <p class="text-xs text-gray-500 mt-1">Type at least 2 characters to search.</p>
      </div>

      <div data-course-search-target="selection" class="space-y-4 border-t border-gray-100 pt-4">
        <%= render "rounds/course_selection",
              selected_course: @selected_course,
              tee_options: @tee_options,
              selected_tee_selector: @selected_tee_selector,
              default_round_name: @default_round_name,
              error_message: @course_selection_error %>
      </div>

      <div>
        <%= f.submit "Create round", class: "rounded px-4 py-2 text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
      </div>
    <% end %>
  </section>

  <%= link_to "← Back to event", event_path(@event), class: "text-sm text-emerald-700 hover:text-emerald-800 underline" %>
</div>
