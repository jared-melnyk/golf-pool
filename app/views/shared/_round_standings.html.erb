<%# locals: standings (RoundStandings#call hash), event (optional) %>
<% standings[:formats].each do |format| %>
  <div class="mt-3 border-t border-gray-200 pt-3" id="round-<%= standings[:round_id] %>-<%= format[:game_type] %>">
    <h4 class="text-sm font-semibold text-gray-900 mb-2"><%= format[:label] %> standings</h4>

    <% if format[:field].any? %>
      <ol class="space-y-1 text-sm">
        <% format[:field].each do |row| %>
          <li class="flex items-baseline justify-between gap-3">
            <span>
              <span class="text-gray-500 tabular-nums mr-1"><%= scorecard_display_rank(row[:rank], format[:field]) %></span>
              <% if row[:game_token].present? %>
                <%= link_to row[:team_name], game_path(row[:game_token]), class: "text-emerald-700 hover:underline font-medium" %>
              <% else %>
                <span class="font-medium text-gray-900"><%= row[:team_name] %></span>
              <% end %>
            </span>
            <span class="tabular-nums text-gray-800"><%= row[:live_label] || "—" %></span>
          </li>
        <% end %>
      </ol>
    <% elsif format[:matches].empty? %>
      <p class="text-sm text-gray-500">No field scores yet.</p>
    <% end %>

    <% if format[:matches].any? %>
      <p class="text-xs font-medium text-gray-600 mt-2 mb-1">Matches</p>
      <ul class="space-y-1 text-sm">
        <% format[:matches].each do |match| %>
          <li>
            <%= link_to match[:game_name], game_path(match[:game_token]), class: "text-emerald-700 hover:underline font-medium" %>
            <span class="text-gray-600">· <%= match[:label] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
