<%# locals: standings (EventIndividualStandings#call hash) %>
<% rounds = standings[:rounds] %>
<% players = standings[:players] %>

<section class="mb-6 border border-gray-200 rounded-lg p-4 bg-white shadow-sm" id="individual-standings">
  <h2 class="text-lg font-semibold text-gray-900 mb-1">Overall low net</h2>
  <p class="text-sm text-gray-600 mb-3">
    Individual net vs par at <strong>100% course handicap</strong> (not format playing handicap). Updates as hole scores are entered.
  </p>

  <% if players.none? { |p| p[:total_vs_par] } %>
    <p class="text-sm text-gray-500">No individual scores yet.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left text-gray-600 border-b border-gray-200">
            <th class="pb-2 pr-3 font-semibold">#</th>
            <th class="pb-2 pr-3 font-semibold">Player</th>
            <% rounds.each do |round| %>
              <th class="pb-2 pr-3 font-semibold whitespace-nowrap"><%= round[:name] %></th>
            <% end %>
            <th class="pb-2 font-semibold text-emerald-800">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% players.each do |row| %>
            <tr>
              <td class="py-1.5 pr-3 tabular-nums text-gray-500"><%= scorecard_display_rank(row[:rank], players) %></td>
              <td class="py-1.5 pr-3 font-medium text-gray-900"><%= row[:name] %></td>
              <% rounds.each do |round| %>
                <% vs = row[:round_vs_par][round[:id]] %>
                <% thru = row[:round_thru][round[:id]] %>
                <td class="py-1.5 pr-3 tabular-nums text-gray-800">
                  <% if vs.nil? %>
                    —
                  <% elsif thru == 18 %>
                    <%= format_total_to_par(vs) %>
                  <% else %>
                    <%= LiveScoreFormatting.thru_label(vs, thru) %>
                  <% end %>
                </td>
              <% end %>
              <td class="py-1.5 tabular-nums font-semibold text-emerald-800">
                <%= row[:total_vs_par].nil? ? "—" : format_total_to_par(row[:total_vs_par]) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
