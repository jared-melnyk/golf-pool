<%# locals: pool, pool_tournament, tournament, picks_by_user (Hash[user_id => Pick]) %>
<section class="mt-2 border border-gray-200 rounded-lg shadow-sm bg-white overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-700">Member</th>
          <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-700">Picks</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold text-gray-700">Max Bonus</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold text-gray-700">Total Earnings</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% pool.users.order(:name).each do |member| %>
          <% pick = picks_by_user[member.id] %>
          <% show_member_stats = pool_tournament.can_view_member_picks?(current_user, member) %>
          <tr class="align-top">
            <td class="px-3 py-2 whitespace-nowrap text-gray-900 font-medium">
              <%= member.name %>
            </td>
            <td class="px-3 py-2">
              <% if pick.present? %>
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                  Submitted
                </span>
                <% if member == current_user && !tournament.picks_locked? %>
                  <%= link_to "Edit picks",
                              edit_pool_pick_path(pool, pick),
                              class: "block text-emerald-600 hover:underline text-xs mt-1" %>
                <% end %>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600">
                  No pick
                </span>
                <% if member == current_user && tournament.picks_open? %>
                  <%= link_to "Make picks",
                              new_pool_pick_path(pool, tournament_id: tournament.id),
                              class: "inline-flex items-center rounded-md px-3 py-1.5 text-xs font-semibold bg-emerald-600 text-white shadow-sm hover:bg-emerald-700 mt-1" %>
                <% elsif member == current_user %>
                  <span class="block text-xs text-gray-500 mt-1">
                    Picks open <%= l(tournament.picks_open_at.to_date, format: :long) %>
                  </span>
                <% end %>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right whitespace-nowrap text-gray-500">
              <% if show_member_stats %>
                <% max_bonus = pool.max_bonus_top_three_for(member, pool_tournament) %>
                <% if max_bonus.present? %>
                  $<%= number_with_delimiter(max_bonus.to_i) %>
                <% else %>
                  —
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-3 py-2 text-right whitespace-nowrap text-gray-900 font-medium">
              <% if pick.present? && tournament.started? %>
                $<%= number_with_delimiter(pool.points_for_pool_tournament(member, pool_tournament).to_i) %>
              <% else %>
                —
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
