<%# locals: pool, pool_tournament, tournament, picks_by_user (Hash[user_id => Pick]) %>
<section class="mt-2 border border-gray-200 rounded-lg shadow-sm bg-white">
  <header class="px-3 py-2 border-b border-gray-200 bg-gray-50 rounded-t-lg">
    <h3 class="text-sm font-medium text-gray-900">Results summary for <%= tournament.name %></h3>
    <p class="text-xs text-gray-600 mt-1">
      Totals use each member&#39;s top three golfer scores for this event, same as pool standings.
    </p>
  </header>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-700">Member</th>
          <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-700">Picks</th>
          <th scope="col" class="px-3 py-2 text-right font-semibold text-gray-700">Tournament total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% pool.users.order(:name).each do |member| %>
          <% pick = picks_by_user[member.id] %>
          <tr class="align-top">
            <td class="px-3 py-2 whitespace-nowrap text-gray-900">
              <div class="font-medium"><%= member.name %></div>
            </td>
            <td class="px-3 py-2">
              <% if pick.present? %>
                <% if pool_tournament.can_view_all_picks?(current_user) || pool_tournament.can_view_member_picks?(current_user, member) %>
                  <ul class="list-disc list-inside space-y-0.5 text-gray-800">
                    <% pick.pick_golfers.order(:slot).each do |pg| %>
                      <% odds = pool_tournament.pool_tournament_odds.find { |o| o.golfer_id == pg.golfer_id }&.american_odds %>
                      <li>
                        <span><%= golfer_name_with_bonus(pg.golfer&.name, odds, tournament: tournament) %></span>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                    Pick submitted
                  </span>
                <% end %>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600">
                  No pick
                </span>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right whitespace-nowrap text-gray-900 font-medium">
              $<%= number_with_delimiter(pool.points_for_pool_tournament(member, pool_tournament).to_i) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
